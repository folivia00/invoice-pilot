{
  "id": "InvPilotLocal001",
  "name": "Invoice Pilot: local file to JSON result",
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {},
  "tags": [],
  "nodes": [
    {
      "id": "3c1f0a52-1d0e-4b7e-9a51-000000000001",
      "name": "Start",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [0, 0],
      "parameters": {}
    },
    {
      "id": "3c1f0a52-1d0e-4b7e-9a51-000000000002",
      "name": "Read invoice file",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1.1,
      "position": [220, 0],
      "parameters": {
        "operation": "read",
        "fileSelector": "={{ $env.INVOICE_PILOT_FILE || '/files/invoices/inv-001.pdf' }}",
        "options": {
          "dataPropertyName": "data"
        }
      }
    },
    {
      "id": "3c1f0a52-1d0e-4b7e-9a51-000000000003",
      "name": "Extract invoice",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [440, 0],
      "parameters": {
        "method": "POST",
        "url": "={{ ($env.INVOICE_PILOT_URL || 'http://api:8080') + '/extract' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.INVOICE_PILOT_API_TOKEN }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "multipart-form-data",
        "bodyParameters": {
          "parameters": [
            {
              "parameterType": "formBinaryData",
              "name": "file",
              "inputDataFieldName": "data"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "3c1f0a52-1d0e-4b7e-9a51-000000000004",
      "name": "Needs review?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [660, 0],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "8b0a6f3e-2f53-4d7c-8a3b-000000000001",
              "leftValue": "={{ $json.status }}",
              "rightValue": "needs_review",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "3c1f0a52-1d0e-4b7e-9a51-000000000005",
      "name": "Review result to JSON",
      "type": "n8n-nodes-base.convertToFile",
      "typeVersion": 1.1,
      "position": [880, -120],
      "parameters": {
        "operation": "toJson",
        "mode": "each",
        "binaryPropertyName": "data",
        "options": {
          "format": true
        }
      }
    },
    {
      "id": "3c1f0a52-1d0e-4b7e-9a51-000000000006",
      "name": "Write to review folder",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1.1,
      "position": [1100, -120],
      "parameters": {
        "operation": "write",
        "fileName": "=/files/results/needs_review-invoice-{{ $('Extract invoice').item.json.document_id }}.json",
        "dataPropertyName": "data",
        "options": {}
      }
    },
    {
      "id": "3c1f0a52-1d0e-4b7e-9a51-000000000007",
      "name": "Approved result to JSON",
      "type": "n8n-nodes-base.convertToFile",
      "typeVersion": 1.1,
      "position": [880, 120],
      "parameters": {
        "operation": "toJson",
        "mode": "each",
        "binaryPropertyName": "data",
        "options": {
          "format": true
        }
      }
    },
    {
      "id": "3c1f0a52-1d0e-4b7e-9a51-000000000008",
      "name": "Write to approved folder",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1.1,
      "position": [1100, 120],
      "parameters": {
        "operation": "write",
        "fileName": "=/files/results/approved-invoice-{{ $('Extract invoice').item.json.document_id }}.json",
        "dataPropertyName": "data",
        "options": {}
      }
    }
  ],
  "connections": {
    "Start": {
      "main": [[{"node": "Read invoice file", "type": "main", "index": 0}]]
    },
    "Read invoice file": {
      "main": [[{"node": "Extract invoice", "type": "main", "index": 0}]]
    },
    "Extract invoice": {
      "main": [[{"node": "Needs review?", "type": "main", "index": 0}]]
    },
    "Needs review?": {
      "main": [
        [{"node": "Review result to JSON", "type": "main", "index": 0}],
        [{"node": "Approved result to JSON", "type": "main", "index": 0}]
      ]
    },
    "Review result to JSON": {
      "main": [[{"node": "Write to review folder", "type": "main", "index": 0}]]
    },
    "Approved result to JSON": {
      "main": [[{"node": "Write to approved folder", "type": "main", "index": 0}]]
    }
  }
}
