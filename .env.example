# Copy to .env (never commit real values). One KEY=value per line, no quotes, no export.

# Telegram bot token from @BotFather (required, secret)
BOT_TOKEN=
# Google Gemini API key (required, secret)
GEMINI_API_KEY=
# Deployment profile: compact (5 MB files, one document at a time) or full (10 MB, 4 in parallel)
PROFILE=compact
# Directory for the SQLite database (created by "uv run alembic upgrade head")
DATA_DIR=./data
# Comma-separated Telegram user IDs with admin rights (may be empty)
ADMIN_IDS=
# Gemini model; it must have a price in invoice_pilot.llm.pricing
LLM_MODEL=gemini-3.5-flash-lite
# Maximum model requests per minute, retries included (Gemini free tier: 15)
LLM_RPM=14
# Documents per user per UTC day
USER_DAILY_DOCS=5
# Documents for all users per UTC day (Gemini free tier: 500 requests per day)
GLOBAL_DAILY_DOCS=300
# LLM spend per UTC day for all users, in USD at paid-tier list prices
GLOBAL_DAILY_BUDGET_USD=0.50
# Uploads allowed to wait in line for processing; more are refused (try again later)
QUEUE_MAX=10
# Days to keep extracted fields and call metadata before automatic deletion
RETENTION_DAYS=7
# Log level: DEBUG, INFO, WARNING or ERROR
LOG_LEVEL=INFO

# HTTP API (python -m invoice_pilot.api; see docs/api.md)
# Bearer token clients must send to POST /extract (required for the API, secret)
API_TOKEN=
# Address the API listens on (0.0.0.0 inside a container)
API_HOST=127.0.0.1
# Port the API listens on
API_PORT=8080
# Documents the API accepts per UTC day (its own counter, separate from Telegram users)
API_DAILY_DOCS=100
# 1 = built-in synthetic answers instead of the model (checks without keys, never in production)
LLM_FAKE=0
